{
  "name": "senales-pedidos",
  "version": "2.0.0",
  "description": "Señalética: pedidos de señales (Operaciones, Marketing, Producción) — microservicio integrable al ERP de RRHH e Inventario",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
