  },
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "daisyui": "^5.7.50",
    "lucide": "^1.61.0",
    "tailwindcss": "^4.3.3"
  }
