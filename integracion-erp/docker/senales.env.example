# ── Copiar a ../core-database/envs/senales.env (junto a erp-backend.env) ──
NODE_ENV=production
PORT=9001
APP_TIMEZONE=America/Lima

# Base de datos propia del microservicio (mismo servidor PostgreSQL del ERP, otra BD)
DB_HOST=<host de PostgreSQL en core-internal>
DB_PORT=5432
DB_NAME=senales
DB_USER=senales_app
DB_PASSWORD=<clave>
DB_SSL=false

# Sesión única con el ERP
AUTH_MODE=erp
ERP_JWT_SECRET=<el MISMO valor de SECRET_KEY de erp-backend.env>
ERP_API_URL=http://erp-backend:9000/api/v1
# Cuenta del ERP con rol LOGISTICA (o ADMIN) para leer inventario y empleados
ERP_SERVICE_USER=svc.senales
ERP_SERVICE_PASSWORD=<clave de esa cuenta>

# Rutas que abre el navegador (mismo dominio del ERP)
ERP_PUBLIC_API_URL=/api/v1
ERP_LOGIN_URL=/login
ERP_INVENTARIO_URL=/inventory/movements

# Traducción de áreas de RRHH a áreas de Señalética (el nombre del área CONTIENE el texto)
ERP_MAPEO_AREAS={"OPERACIONES":["OPERACION"],"MARKETING":["MARKETING"],"PRODUCCION":["PRODUCCION","PLANTA","TALLER"]}
# Opcional, por id de área del ERP: {"MARKETING":[4],"PRODUCCION":[7]}
ERP_MAPEO_AREA_IDS=
ERP_ROLES_ADMIN=ADMIN,GERENTE,TI
ERP_ROLES_LOGISTICA=LOGISTICA

# SharePoint (imágenes de señales) — mismas credenciales de Azure que usa el ERP
CLIENT_ID=
TENANT_ID=
CLIENT_SECRET=
SHAREPOINT_SITE_ID=
SHAREPOINT_DRIVE_ID=
