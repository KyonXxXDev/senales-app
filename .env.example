# ── Desarrollo local ──────────────────────────────────────────────────────
PORT=9001
APP_TIMEZONE=America/Lima
DB_HOST=localhost
DB_PORT=5432
DB_NAME=senales
DB_USER=postgres
DB_PASSWORD=postgres

# local = selector de colaborador propio (sin ERP) · erp = sesión única con el ERP
AUTH_MODE=local
SECRET_KEY=cambia_esta_clave

# ── Integración con el ERP (AUTH_MODE=erp) ── ver integracion-erp/docker/senales.env.example
# ERP_JWT_SECRET=<SECRET_KEY del ERP>
# ERP_API_URL=http://localhost:9000/api/v1
# ERP_SERVICE_USER=svc.senales
# ERP_SERVICE_PASSWORD=
# ERP_LOGIN_URL=/login

# ── SharePoint (opcional, imágenes de señales) ──
# CLIENT_ID=
# TENANT_ID=
# CLIENT_SECRET=
# SHAREPOINT_SITE_ID=
# SHAREPOINT_DRIVE_ID=
